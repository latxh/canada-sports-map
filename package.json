{
  "name": "canada-sports-map",
  "version": "0.1.0",
  "description": "Interactive map of Canadian pro sports cities, teams, venues and history across the NHL, NBA, MLB, MLS, CFL and CPL. Built with Astryx.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "geo": "node scripts/build-geo.mjs",
    "og": "node scripts/render-og.mjs"
  },
  "type": "module",
  "dependencies": {
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-neutral": "^0.7.11",
    "@stylexjs/stylex": "^0.19.1",
    "d3-geo": "^3.1.2",
    "d3-interpolate": "^3.0.2",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/latxh/canada-sports-map.git"
  }
}
